{
  "name": "blood-on-the-clocktower-encyclopedia",
  "version": "0.1.0",
  "private": true,
  "description": "A web encyclopedia prototype for Blood on the Clocktower.",
  "scripts": {
    "start": "node backend/server.js",
    "check": "node scripts/check-javascript.js && node scripts/validate-library-data.js",
    "check:js": "node scripts/check-javascript.js",
    "validate:data": "node scripts/validate-library-data.js",
    "official:import": "node scripts/manage-official-json.js import",
    "official:export": "node scripts/manage-official-json.js export",
    "images:cache": "node scripts/cache-library-images.js",
    "ability-terms:check": "node scripts/sync-ability-terms.js",
    "ability-terms:sync": "node scripts/sync-ability-terms.js --write",
    "ability-semantics:check": "node scripts/sync-ability-semantics.js",
    "ability-semantics:sync": "node scripts/sync-ability-semantics.js --write",
    "deduction:check": "node scripts/sync-deduction-profiles.js",
    "deduction:sync": "node scripts/sync-deduction-profiles.js --write",
    "deduction:audit": "node scripts/audit-deduction-profiles.js",
    "setup-meta:check": "node scripts/sync-setup-meta.js",
    "setup-meta:sync": "node scripts/sync-setup-meta.js --write",
    "setup-meta:refresh": "node scripts/sync-setup-meta.js --write --refresh",
    "roles:dedupe:check": "node scripts/dedupe-role-abilities.js",
    "roles:dedupe": "node scripts/dedupe-role-abilities.js --write",
    "roles:english-names:check": "node scripts/clean-role-english-names.js",
    "roles:english-names:clean": "node scripts/clean-role-english-names.js --write"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
