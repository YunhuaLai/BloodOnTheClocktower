{
  "name": "blood-on-the-clocktower-encyclopedia",
  "version": "0.1.0",
  "private": true,
  "description": "A web encyclopedia prototype for Blood on the Clocktower.",
  "scripts": {
    "start": "node backend/server.js",
    "check": "node scripts/check-js.js && node scripts/validate-data.js",
    "check:js": "node scripts/check-js.js",
    "validate:data": "node scripts/validate-data.js",
    "deduction:audit": "node scripts/deduction-profile-audit.js",
    "deduction:backfill": "node scripts/backfill-deduction-profiles.js",
    "ability-terms:check": "node scripts/backfill-ability-terms.js",
    "ability-terms:backfill": "node scripts/backfill-ability-terms.js --write",
    "official:import": "node scripts/official-json.js import",
    "official:export": "node scripts/official-json.js export",
    "cache:images": "node scripts/cache-images.js",
    "setup-meta:check": "node scripts/backfill-setup-meta.js",
    "setup-meta:write": "node scripts/backfill-setup-meta.js --write",
    "roles:dedupe:check": "node scripts/dedupe-roles-by-ability.js",
    "roles:dedupe": "node scripts/dedupe-roles-by-ability.js --write",
    "english-names:check": "node scripts/clean-english-names.js",
    "english-names:clean": "node scripts/clean-english-names.js --write",
    "rebuild:library": "node scripts/rebuild-library-from-catalog.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
